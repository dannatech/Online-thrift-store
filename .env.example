# Copy to .env (never commit it) or set these in your hosting provider.
# Leave STRIPE_SECRET_KEY empty to run the market in demo mode.

# Stripe Dashboard → Developers → API keys. Use sk_test_... until you launch.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or Dashboard → Developers → Webhooks in production.
STRIPE_WEBHOOK_SECRET=
# The address shoppers use to reach the storefront (Stripe sends them back here).
# With the GitHub Pages storefront: https://<user>.github.io/<repo>
PUBLIC_URL=http://localhost:3000
# Other sites allowed to call this server's API, comma-separated.
# With the GitHub Pages storefront: https://<user>.github.io
ALLOWED_ORIGINS=
# The market's commission on each sale, in percent.
MARKET_FEE_PERCENT=10
